APP_NAME=aresCMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# XAMPP unter htdocs/Unterordner: Basis-URL inkl. /public (z. B. http://localhost/news-portal/public)
# Mit „php artisan serve“: http://127.0.0.1:8000
APP_URL=http://localhost

# Hinter Cloudflare / Reverse-Proxy: X-Forwarded-Proto (HTTPS) — für OAuth u. a. Standard "*". Lokal ohne Proxy: TRUSTED_PROXIES=false
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=news_portal
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Cloudflare Turnstile CAPTCHA
# Get your keys from https://dash.cloudflare.com/?to=/:account/turnstile
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Google / Discord OAuth (Laravel Socialite). Redirect-URIs in den Entwicklerkonsolen exakt wie unten eintragen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth/google/callback"
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/oauth/discord/callback"

# Impressum / Datenschutz (Anbieterkennzeichnung — siehe /impressum und /datenschutz)
LEGAL_ENTITY_NAME=
LEGAL_REPRESENTATIVE=
LEGAL_ADDRESS_STREET=
LEGAL_ADDRESS_ZIP=
LEGAL_ADDRESS_CITY=
# Optional; nur sinnvoll zusammen mit Straße/PLZ/Ort (wie auf dem Impressum)
LEGAL_COUNTRY=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_VAT_ID=
LEGAL_REGISTER_INFO=
# Optional: Name für § 18 Abs. 2 MStV / inhaltlich Verantwortliche Person
LEGAL_CONTENT_RESPONSIBILITY=

# Passwortrichtlinie (Registrierung & Passwort zurücksetzen)
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_LETTERS=true
PASSWORD_REQUIRE_MIXED_CASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=false

# Backups (php artisan backup:application → storage/app/backups/*.zip)
# Geplanter Lauf mit Artisan-Scheduler (Cron / Windows Aufgabenplanung: php artisan schedule:run)
BACKUP_SCHEDULE_ENABLED=false
BACKUP_SCHEDULE_TIME=02:00
# Windows: ohne PATH zu MySQL reicht oft nichts – das Backup probiert u. a. ..\..\mysql\bin\mysqldump.exe (XAMPP neben htdocs).
# Falls nötig explizit (Anführungszeichen in .env empfohlen):
# BACKUP_MYSQLDUMP_PATH="C:\xampp\mysql\bin\mysqldump.exe"
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_INCLUDE_PUBLIC_STORAGE=true
# 0 = keine automatische Löschung alter ZIPs
BACKUP_KEEP_DAYS=14

# CMS-Updates (Admin → System updates): HTTPS-URL zu einer JSON-Manifest-Datei
# Beispiel eigener Server: https://update.luetcke.eu/manifest.json
# Optional: eigene Manifest-URL (Standard liegt in config/cms.php → update.luetcke.eu)
# CMS_UPDATE_MANIFEST_URL=
# Optional: Bearer-Token für geschütztes Manifest
# CMS_UPDATE_TOKEN=
# CMS_UPDATE_ENABLED=true
# CMS_MANIFEST_CACHE_TTL=600
# Ausgelieferte Basis-Version (wenn noch keine storage/app/cms/installed_version)
# CMS_BUNDLE_VERSION=1.0.0
# Unter php-fpm: CLI-Binary für Composer (Admin → Betrieb → Abhängigkeiten), z. B.:
# PHP_CLI_BINARY=/opt/lima-php/8.5/bin/php

# Lizenz (Pflicht für Web/API): Schlüssel von key.luetcke.eu, Domain muss dort dem Key zugeordnet sein (localhost möglich).
# Wenn leer: Schlüssel unter https://deine-domain/license eingeben (wird verschlüsselt in storage/app/cms/.license gespeichert).
#
# —— Lokal (ohne key.luetcke.eu): public/dev-license-validate.php nutzen ——
# CMS_LICENSE_KEY=LOCALHOST-DEV-KEY
# XAMPP z. B.: CMS_LICENSE_VALIDATE_URL=http://localhost/news-portal/public/dev-license-validate.php
# artisan serve: CMS_LICENSE_VALIDATE_URL=http://127.0.0.1:8000/dev-license-validate.php
CMS_LICENSE_KEY=
CMS_LICENSE_VALIDATE_URL=https://key.luetcke.eu/validate-license.php
# Optional: nur diese Hosts für die Validierungs-URL (Komma), z. B. key.luetcke.eu — erschwert Fake-Endpunkte ohne Code-Änderung
# CMS_LICENSE_ALLOWED_VALIDATE_HOSTS=key.luetcke.eu
# CMS_LICENSE_ENABLED=true
# CMS_LICENSE_TIMEOUT=10
# CMS_LICENSE_CACHE_TTL=3600
# CMS_LICENSE_GRACE_TTL=604800
# Bei HTTPS mit selbstsigniertem Zertifikat (nur lokal): CMS_LICENSE_VERIFY_SSL=false
